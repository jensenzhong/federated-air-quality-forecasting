{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAFA LLM candidate proposal",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["client_id", "diagnosis", "evidence", "candidate_action_ids"],
        "properties": {
          "client_id": {"type": "string", "minLength": 1},
          "diagnosis": {
            "enum": ["stable", "underfit", "overfit", "drift", "conflict", "tail_risk"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "candidate_action_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": ["safe_default", "cautious", "adapt_fast", "tail_focus"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
